---
const features = [
  {
    title: "AI Resume Analysis",
    description: "Get instant ATS-optimization scores and tailored suggestions to make your profile stand out to recruiters.",
    icon: "brain"
  },
  {
    title: "Job Tracking",
    description: "Manage your entire pipeline in one sleek kanban-style dashboard. Never miss an interview or follow-up deadline.",
    icon: "layout"
  },
  {
    title: "Smart Skill Gap",
    description: "Compare your skills against job descriptions. Get personalized learning paths to bridge the gap and stay competitive.",
    icon: "trending-up"
  }
];
---

<section id="features" class="py-24 relative overflow-hidden">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center mb-16">
    <h2 class="text-3xl md:text-5xl font-bold mb-6 tracking-tight">Engineered for Success</h2>
    <div class="w-16 h-1 bg-emerald-500 mx-auto mb-6 rounded-full"></div>
    <p class="text-gray-400 text-lg max-w-2xl mx-auto leading-relaxed">
      Everything you need to navigate the competitive modern job market with confidence.
    </p>
  </div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
      {features.map((feature) => (
        <div class="group bg-zinc-900/50 border border-white/5 p-8 rounded-3xl hover:border-emerald-500/50 hover:bg-emerald-500/[0.03] transition-all duration-300">
          <div class="w-14 h-14 bg-emerald-500/10 rounded-2xl flex items-center justify-center mb-8 group-hover:scale-110 transition-transform">
            {feature.icon === "brain" && (
                <svg xmlns="http://www.w3.org/2000/svg" class="w-7 h-7 text-emerald-500" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9.5 2A2.5 2.5 0 0 1 12 4.5v15a2.5 2.5 0 0 1-4.96.44 2.5 2.5 0 0 1-2.96-3.08 3 3 0 0 1-.34-5.58 2.5 2.5 0 0 1 1.32-4.24 2.5 2.5 0 0 1 4.44-1.48Z"/><path d="M14.5 2A2.5 2.5 0 0 0 12 4.5v15a2.5 2.5 0 0 0 4.96.44 2.5 2.5 0 0 0 2.96-3.08 3 3 0 0 0 .34-5.58 2.5 2.5 0 0 0-1.32-4.24 2.5 2.5 0 0 0-4.44-1.48Z"/></svg>
            )}
            {feature.icon === "layout" && (
                <svg xmlns="http://www.w3.org/2000/svg" class="w-7 h-7 text-emerald-500" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="18" height="18" x="3" y="3" rx="2" ry="2"/><line x1="3" x2="21" y1="9" y2="9"/><line x1="9" x2="9" y1="21" y2="9"/></svg>
            )}
             {feature.icon === "trending-up" && (
                <svg xmlns="http://www.w3.org/2000/svg" class="w-7 h-7 text-emerald-500" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="23 6 13.5 15.5 8.5 10.5 1 18"/><polyline points="17 6 23 6 23 12"/></svg>
            )}
          </div>
          <h3 class="text-xl font-bold mb-4">{feature.title}</h3>
          <p class="text-gray-400 leading-relaxed text-sm md:text-base">
            {feature.description}
          </p>
        </div>
      ))}
    </div>
  </div>
</section>
