---
---

<section class="relative min-h-screen flex flex-col overflow-hidden">
  <!-- Background Glow Effects -->
  <div class="absolute inset-0 pointer-events-none -z-10">
    <div class="absolute top-0 left-1/4 -translate-x-1/2 w-[700px] h-[600px] bg-emerald-500/15 blur-[150px] rounded-full"></div>
    <div class="absolute top-1/3 right-0 w-[500px] h-[500px] bg-emerald-400/8 blur-[120px] rounded-full"></div>
    <div class="absolute bottom-0 left-1/3 w-[400px] h-[400px] bg-blue-500/8 blur-[100px] rounded-full"></div>
  </div>

  <!-- Content — grows to fill the full viewport -->
  <div class="flex-1 flex items-center max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 w-full py-20 md:py-0">
    <div class="grid lg:grid-cols-2 gap-12 lg:gap-16 items-center w-full">

      <!-- ── Left Column ─────────────────────────────────────────────── -->
      <div class="text-center lg:text-left">
        <!-- Badge -->
        <div class="inline-flex items-center gap-2 px-4 py-2 rounded-full bg-white/5 border border-white/10 backdrop-blur-sm mb-8">
          <span class="flex h-2 w-2 rounded-full bg-emerald-500 animate-pulse"></span>
          <span class="text-sm text-gray-300">Early Access — Join the waitlist</span>
        </div>

        <!-- Heading -->
        <h1 class="text-4xl sm:text-5xl md:text-6xl font-bold tracking-tight mb-6 leading-[1.1]">
          <span class="text-white">Land your </span>
          <span class="relative inline-block">
            <span class="text-transparent bg-clip-text bg-gradient-to-r from-emerald-400 via-emerald-300 to-teal-400">dream job</span>
            <svg class="absolute -bottom-2 left-0 w-full h-1.5 text-emerald-500/50" viewBox="0 0 100 6" preserveAspectRatio="none">
              <path d="M0 3 Q 50 5 100 3" stroke="currentColor" stroke-width="2" fill="none"/>
            </svg>
          </span>
          <br />
          <span class="text-white">with AI intelligence</span>
        </h1>

        <p class="text-gray-400 text-lg md:text-xl max-w-xl mx-auto lg:mx-0 leading-relaxed mb-8">
          The all-in-one platform to optimize your resume and track every application with intelligence designed for the modern job seeker.
        </p>

        <!-- CTAs -->
        <div class="flex flex-col sm:flex-row items-center justify-center lg:justify-start gap-4 mb-8">
          <a href="/dashboard"
            class="group w-full sm:w-auto px-8 py-4 bg-emerald-500 text-black font-bold rounded-full hover:bg-emerald-400 transition-all duration-300 hover:scale-105 flex items-center justify-center gap-2 shadow-lg shadow-emerald-500/25 hover:shadow-emerald-500/40">
            <span>Get Started Free</span>
            <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 group-hover:translate-x-1 transition-transform" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
          </a>
          <button class="w-full sm:w-auto px-8 py-4 border border-white/20 bg-white/5 hover:bg-white/10 hover:border-white/30 font-medium rounded-full text-white transition-all duration-300 backdrop-blur-sm flex items-center justify-center gap-2">
            <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" viewBox="0 0 24 24" fill="currentColor"><path d="M8 5v14l11-7z"/></svg>
            Watch Demo
          </button>
        </div>

        <!-- Trust indicators -->
        <div class="flex items-center justify-center lg:justify-start gap-6 text-sm text-gray-500">
          <div class="flex items-center gap-2">
            <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 text-emerald-500" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>
            <span>No credit card required</span>
          </div>
          <div class="flex items-center gap-2">
            <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 text-emerald-500" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>
            <span>14-day free trial</span>
          </div>
        </div>
      </div>

      <!-- ── Right Column — Dashboard Preview ───────────────────────── -->
      <div class="relative">
        <!-- Glow behind card -->
        <div class="absolute inset-0 bg-emerald-500/10 blur-[60px] rounded-3xl -z-10 translate-y-4"></div>

        <!-- Dashboard mockup -->
        <div class="bg-zinc-900/80 backdrop-blur-xl border border-white/10 rounded-2xl overflow-hidden shadow-2xl shadow-black/50">
          <!-- Browser chrome -->
          <div class="h-10 bg-zinc-800/50 border-b border-white/5 flex items-center px-4">
            <div class="flex gap-2">
              <div class="w-3 h-3 rounded-full bg-red-500/60"></div>
              <div class="w-3 h-3 rounded-full bg-yellow-500/60"></div>
              <div class="w-3 h-3 rounded-full bg-green-500/60"></div>
            </div>
            <div class="flex-1 flex justify-center">
              <div class="px-4 py-1 bg-zinc-800/30 rounded-md text-xs text-gray-500">app.genius.com/dashboard</div>
            </div>
          </div>

          <!-- Dashboard content -->
          <div class="p-6 grid grid-cols-12 gap-4 min-h-[320px] md:min-h-[380px]">
            <!-- Sidebar -->
            <div class="col-span-3 bg-white/5 rounded-xl p-4 flex flex-col gap-4">
              <div class="w-10 h-10 bg-gradient-to-br from-emerald-500 to-emerald-600 rounded-lg flex items-center justify-center">
                <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6 text-black" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m12 3-1.912 5.813a2 2 0 0 1-1.275 1.275L3 12l5.813 1.912a2 2 0 0 1 1.275 1.275L12 21l1.912-5.813a2 2 0 0 1 1.275-1.275L21 12l-5.813-1.912a2 2 0 0 1-1.275-1.275L12 3Z"/></svg>
              </div>
              <div class="space-y-2">
                <div class="w-full h-3 bg-white/10 rounded-full"></div>
                <div class="w-3/4 h-3 bg-white/10 rounded-full"></div>
                <div class="w-1/2 h-3 bg-white/10 rounded-full"></div>
              </div>
              <div class="mt-auto space-y-2">
                <div class="w-full h-8 bg-emerald-500/20 rounded-lg"></div>
                <div class="w-full h-8 bg-white/5 rounded-lg"></div>
                <div class="w-full h-8 bg-white/5 rounded-lg"></div>
              </div>
            </div>

            <!-- Main content -->
            <div class="col-span-9 flex flex-col gap-4">
              <!-- Stats row -->
              <div class="grid grid-cols-4 gap-3 md:gap-4">
                <div class="bg-white/5 rounded-xl p-3 md:p-4">
                  <div class="w-8 h-8 bg-emerald-500/20 rounded-lg mb-2 md:mb-3"></div>
                  <div class="w-1/2 h-3 bg-white/10 rounded-full mb-2"></div>
                  <div class="w-3/4 h-6 bg-white/10 rounded-full"></div>
                </div>
                <div class="bg-white/5 rounded-xl p-3 md:p-4">
                  <div class="w-8 h-8 bg-blue-500/20 rounded-lg mb-2 md:mb-3"></div>
                  <div class="w-1/2 h-3 bg-white/10 rounded-full mb-2"></div>
                  <div class="w-3/4 h-6 bg-white/10 rounded-full"></div>
                </div>
                <div class="bg-white/5 rounded-xl p-3 md:p-4">
                  <div class="w-8 h-8 bg-purple-500/20 rounded-lg mb-2 md:mb-3"></div>
                  <div class="w-1/2 h-3 bg-white/10 rounded-full mb-2"></div>
                  <div class="w-3/4 h-6 bg-white/10 rounded-full"></div>
                </div>
                <div class="bg-white/5 rounded-xl p-3 md:p-4">
                  <div class="w-8 h-8 bg-orange-500/20 rounded-lg mb-2 md:mb-3"></div>
                  <div class="w-1/2 h-3 bg-white/10 rounded-full mb-2"></div>
                  <div class="w-3/4 h-6 bg-white/10 rounded-full"></div>
                </div>
              </div>

              <!-- Chart area -->
              <div class="flex-1 bg-white/5 rounded-xl p-4 flex gap-4">
                <div class="flex-1 flex items-end gap-2 px-4">
                  <div class="w-full bg-gradient-to-t from-emerald-500/30 to-emerald-500/10 rounded-t-lg" style="height: 40%"></div>
                  <div class="w-full bg-gradient-to-t from-emerald-500/30 to-emerald-500/10 rounded-t-lg" style="height: 60%"></div>
                  <div class="w-full bg-gradient-to-t from-emerald-500/30 to-emerald-500/10 rounded-t-lg" style="height: 45%"></div>
                  <div class="w-full bg-gradient-to-t from-emerald-500/30 to-emerald-500/10 rounded-t-lg" style="height: 75%"></div>
                  <div class="w-full bg-gradient-to-t from-emerald-500/30 to-emerald-500/10 rounded-t-lg" style="height: 55%"></div>
                  <div class="w-full bg-gradient-to-t from-emerald-500/30 to-emerald-500/10 rounded-t-lg" style="height: 80%"></div>
                  <div class="w-full bg-gradient-to-t from-emerald-500/30 to-emerald-500/10 rounded-t-lg" style="height: 65%"></div>
                </div>
                <div class="w-32 md:w-48 bg-black/20 rounded-lg p-4 flex flex-col gap-3">
                  <div class="w-full h-4 bg-white/10 rounded-full"></div>
                  <div class="w-full h-4 bg-white/10 rounded-full"></div>
                  <div class="w-full h-4 bg-white/10 rounded-full"></div>
                  <div class="mt-auto w-full h-12 bg-emerald-500/20 rounded-lg"></div>
                </div>
              </div>
            </div>
          </div>
        </div>

        <!-- Floating badge — Resume Score -->
        <div class="absolute -right-3 md:-right-4 top-8 md:top-12 bg-zinc-900/90 backdrop-blur-sm border border-white/10 rounded-xl p-3 md:p-4 shadow-xl"
          style="animation: float 3s ease-in-out infinite;">
          <div class="flex items-center gap-3">
            <div class="w-10 h-10 bg-emerald-500 rounded-full flex items-center justify-center shrink-0">
              <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6 text-black" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>
            </div>
            <div>
              <div class="text-sm font-semibold text-white">Resume Score</div>
              <div class="text-xs text-emerald-400">+15 points</div>
            </div>
          </div>
        </div>

        <!-- Floating badge — Applications -->
        <div class="absolute -left-3 md:-left-4 bottom-12 bg-zinc-900/90 backdrop-blur-sm border border-white/10 rounded-xl p-3 md:p-4 shadow-xl"
          style="animation: float 3.5s ease-in-out infinite; animation-delay: 0.5s;">
          <div class="flex items-center gap-3">
           
            
          </div>
        </div>
      </div>

    </div>
  </div>

  <!-- Scroll cue -->
  <div class="flex justify-center pb-8">
    <div class="flex flex-col items-center gap-2 text-gray-600 animate-bounce" style="animation-duration: 2s;">
      <span class="text-xs tracking-widest uppercase">Scroll</span>
      <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m6 9 6 6 6-6"/></svg>
    </div>
  </div>
</section>

<style>
  @keyframes float {
    0%, 100% { transform: translateY(0px); }
    50%       { transform: translateY(-10px); }
  }
</style>