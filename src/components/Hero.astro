---
---

<section class="relative min-h-screen flex flex-col overflow-hidden bg-[#080a0f]">

  <!-- Background Glows -->
  <div class="absolute inset-0 pointer-events-none -z-10">
    <div class="absolute top-[-100px] left-1/4 w-[600px] h-[600px] rounded-full" style="background:radial-gradient(circle,rgba(16,185,129,0.12) 0%,transparent 70%)"></div>
    <div class="absolute top-1/2 right-0 w-[400px] h-[500px] rounded-full" style="background:radial-gradient(circle,rgba(99,102,241,0.07) 0%,transparent 70%)"></div>
    <div class="absolute bottom-0 left-0 w-[500px] h-[400px] rounded-full" style="background:radial-gradient(circle,rgba(16,185,129,0.05) 0%,transparent 70%)"></div>
    <!-- Subtle grid -->
    <div class="absolute inset-0 opacity-[0.025]" style="background-image:linear-gradient(rgba(255,255,255,0.5) 1px,transparent 1px),linear-gradient(90deg,rgba(255,255,255,0.5) 1px,transparent 1px);background-size:60px 60px"></div>
  </div>

  <!-- Main content -->
  <div class="flex-1 flex items-center max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 w-full py-24 md:py-0">
    <div class="grid lg:grid-cols-2 gap-16 lg:gap-20 items-center w-full">

      <!-- ── Left Column ── -->
      <div class="text-center lg:text-left">

        <!-- Badge -->
        <div class="inline-flex items-center gap-2.5 px-4 py-2 rounded-full border border-white/10 bg-white/[0.03] backdrop-blur-sm mb-10">
          <span class="relative flex h-2 w-2">
            <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-emerald-400 opacity-75"></span>
            <span class="relative inline-flex rounded-full h-2 w-2 bg-emerald-500"></span>
          </span>
          <span class="text-xs font-medium text-gray-400 tracking-wide">Early Access — Join the waitlist</span>
        </div>

        <!-- Heading -->
        <h1 class="text-5xl sm:text-6xl font-bold tracking-tight mb-6 leading-[1.08]" style="font-family:'Sora',sans-serif">
          <span class="text-white">Land your </span>
          <span class="relative inline-block">
            <span class="text-transparent bg-clip-text" style="background-image:linear-gradient(135deg,#10b981,#34d399,#6ee7b7)">dream job</span>
            <svg class="absolute -bottom-1.5 left-0 w-full h-1" viewBox="0 0 160 4" preserveAspectRatio="none" fill="none">
              <path d="M0 2 Q80 4 160 2" stroke="url(#ul)" stroke-width="2"/>
              <defs><linearGradient id="ul" x1="0" x2="160" y1="0" y2="0" gradientUnits="userSpaceOnUse"><stop offset="0%" stop-color="#10b981" stop-opacity="0"/><stop offset="50%" stop-color="#10b981"/><stop offset="100%" stop-color="#10b981" stop-opacity="0"/></linearGradient></defs>
            </svg>
          </span>
          <br />
          <span class="text-white">with AI intelligence</span>
        </h1>

        <p class="text-gray-500 text-lg md:text-xl max-w-xl mx-auto lg:mx-0 leading-relaxed mb-10">
          The all-in-one platform to optimize your resume and track every application — built for the modern job seeker.
        </p>

        <!-- CTAs -->
        <div class="flex flex-col sm:flex-row items-center justify-center lg:justify-start gap-3 mb-10">
          <a href="/dashboard"
            class="group relative w-full sm:w-auto px-8 py-4 bg-emerald-500 text-black font-bold rounded-full transition-all duration-300 hover:bg-emerald-400 hover:scale-[1.03] flex items-center justify-center gap-2 text-sm overflow-hidden"
            style="box-shadow:0 0 0 1px rgba(16,185,129,0.3),0 8px 32px rgba(16,185,129,0.25)">
            <span class="relative z-10">Get Started Free</span>
            <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 relative z-10 group-hover:translate-x-1 transition-transform" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
          </a>
          <button class="w-full sm:w-auto px-8 py-4 border border-white/10 bg-white/[0.03] hover:bg-white/[0.07] hover:border-white/20 font-medium rounded-full text-white transition-all duration-300 backdrop-blur-sm flex items-center justify-center gap-2.5 text-sm">
            <span class="flex items-center justify-center w-5 h-5 rounded-full border border-white/20">
              <svg xmlns="http://www.w3.org/2000/svg" class="w-2.5 h-2.5" viewBox="0 0 24 24" fill="currentColor"><path d="M8 5v14l11-7z"/></svg>
            </span>
            Watch Demo
          </button>
        </div>

        <!-- Trust indicators -->
        <div class="flex flex-wrap items-center justify-center lg:justify-start gap-x-6 gap-y-2 text-sm text-gray-600">
          <div class="flex items-center gap-2">
            <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 text-emerald-500" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>
            <span>No credit card required</span>
          </div>
          <div class="flex items-center gap-2">
            <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 text-emerald-500" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>
            <span>14-day free trial</span>
          </div>
          <div class="flex items-center gap-2">
            <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 text-emerald-500" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="11" width="18" height="11" rx="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
            <span>SOC 2 secured</span>
          </div>
        </div>

      </div>

      <!-- ── Right Column ── -->
      <div class="relative flex items-center justify-center">

        <!-- Ambient glow behind card -->
        <div class="absolute inset-4 rounded-3xl -z-10" style="background:radial-gradient(ellipse,rgba(16,185,129,0.12) 0%,transparent 70%);filter:blur(20px)"></div>

        <!-- ─── Main Resume Intelligence Card ─── -->
        <div class="relative w-full max-w-[440px]" style="font-family:'Sora',sans-serif">
          <div class="rounded-2xl border border-white/8 overflow-hidden" style="background:#111318;box-shadow:0 32px 80px rgba(0,0,0,0.6),inset 0 1px 0 rgba(255,255,255,0.06)">

            <!-- Top shine -->
            <div class="h-px w-full" style="background:linear-gradient(90deg,transparent,rgba(16,185,129,0.5),transparent)"></div>

            <div class="p-6">
              <!-- Header -->
              <div class="flex items-center justify-between mb-5">
                <div>
                  <p class="text-[10px] font-semibold tracking-[0.12em] text-gray-600 uppercase mb-1">Resume Intelligence</p>
                  <p class="text-sm font-semibold text-white">Your report · Updated now</p>
                </div>
                <div class="flex items-center gap-1.5 px-3 py-1.5 rounded-full border border-emerald-500/20 bg-emerald-500/8">
                  <span class="w-1.5 h-1.5 rounded-full bg-emerald-400 animate-pulse"></span>
                  <span class="text-[10px] font-semibold text-emerald-400 tracking-wide">LIVE</span>
                </div>
              </div>

              <!-- Score + bar -->
              <div class="flex items-center gap-5 mb-5">
                <div class="relative w-20 h-20 flex-shrink-0">
                  <svg class="w-20 h-20 -rotate-90" viewBox="0 0 80 80">
                    <circle cx="40" cy="40" r="32" fill="none" stroke="#1f2330" stroke-width="6"/>
                    <circle cx="40" cy="40" r="32" fill="none" stroke="#10b981" stroke-width="6" stroke-linecap="round"
                      stroke-dasharray="201.1" stroke-dashoffset="44" class="score-arc"/>
                  </svg>
                  <div class="absolute inset-0 flex flex-col items-center justify-center">
                    <span class="text-xl font-bold text-white leading-none">87</span>
                    <span class="text-[8px] text-gray-600 font-medium">/100</span>
                  </div>
                </div>
                <div class="flex-1">
                  <p class="text-sm font-semibold text-white mb-1">Strong Resume</p>
                  <p class="text-[11px] text-gray-500 leading-relaxed mb-2.5">Scores above 91% of applicants in Product Design.</p>
                  <div class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full bg-emerald-500/10 border border-emerald-500/20">
                    <svg class="w-2.5 h-2.5 text-emerald-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="18 15 12 9 6 15"/></svg>
                    <span class="text-[10px] font-bold text-emerald-400">+15 pts this week</span>
                  </div>
                </div>
              </div>

              <!-- Divider -->
              <div class="h-px bg-white/5 mb-4"></div>

              <!-- AI suggestions -->
              <div class="mb-4">
                <div class="flex items-center gap-2 mb-3">
                  <span class="w-1.5 h-1.5 rounded-full bg-emerald-400 animate-pulse"></span>
                  <span class="text-[10px] font-semibold tracking-[0.1em] text-emerald-400 uppercase">AI Suggestions</span>
                </div>
                <div class="space-y-2">
                  <div class="flex items-start gap-2.5 p-2.5 rounded-xl border border-white/5 bg-white/[0.02]">
                    <div class="w-5 h-5 rounded-md bg-emerald-500/10 flex items-center justify-center flex-shrink-0 mt-0.5">
                      <svg class="w-2.5 h-2.5 text-emerald-500" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"/></svg>
                    </div>
                    <p class="text-[11px] text-gray-500 leading-relaxed"><span class="text-gray-200 font-medium">Add metrics to experience —</span> Quantify impact. "Reduced onboarding time by 40%."</p>
                  </div>
                  <div class="flex items-start gap-2.5 p-2.5 rounded-xl border border-white/5 bg-white/[0.02]">
                    <div class="w-5 h-5 rounded-md bg-indigo-500/10 flex items-center justify-center flex-shrink-0 mt-0.5">
                      <svg class="w-2.5 h-2.5 text-indigo-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M12 20h9"/><path d="M16.5 3.5a2.121 2.121 0 0 1 3 3L7 19l-4 1 1-4z"/></svg>
                    </div>
                    <p class="text-[11px] text-gray-500 leading-relaxed"><span class="text-gray-200 font-medium">Tailor for Figma roles —</span> Mention "design systems" and "component libraries."</p>
                  </div>
                </div>
              </div>

              <!-- Skills -->
              <div>
                <p class="text-[10px] font-semibold tracking-[0.1em] text-gray-600 uppercase mb-2.5">Matched skills</p>
                <div class="flex flex-wrap gap-1.5">
                  <span class="text-[10px] font-medium px-2.5 py-1 rounded-full bg-emerald-500/8 border border-emerald-500/20 text-emerald-300">Figma</span>
                  <span class="text-[10px] font-medium px-2.5 py-1 rounded-full bg-emerald-500/8 border border-emerald-500/20 text-emerald-300">UX Research</span>
                  <span class="text-[10px] font-medium px-2.5 py-1 rounded-full bg-emerald-500/8 border border-emerald-500/20 text-emerald-300">Prototyping</span>
                  <span class="text-[10px] font-medium px-2.5 py-1 rounded-full bg-indigo-500/8 border border-indigo-500/20 text-indigo-300">Design Systems</span>
                  <span class="text-[10px] font-medium px-2.5 py-1 rounded-full bg-indigo-500/8 border border-indigo-500/20 text-indigo-300">Accessibility</span>
                  <span class="text-[10px] font-medium px-2.5 py-1 rounded-full bg-white/3 border border-white/8 text-gray-500">Motion Design</span>
                  <span class="text-[10px] font-medium px-2.5 py-1 rounded-full bg-white/3 border border-white/8 text-gray-500">React</span>
                </div>
              </div>
            </div>
          </div>

          <!-- ── Floating Card: Notion Job Match ── -->
          <div class="absolute -right-6 top-8 rounded-2xl border border-white/10 p-3 w-48" style="background:#16181f;box-shadow:0 8px 32px rgba(0,0,0,0.5);animation:floatA 3.5s ease-in-out infinite">
            <div class="flex items-center gap-2.5 mb-2.5">
              <div class="w-7 h-7 rounded-lg flex items-center justify-center flex-shrink-0" style="background:#1d2d6b">
                <svg class="w-3.5 h-3.5 text-indigo-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="18" height="18" rx="3"/><path d="M9 9h6M9 12h6M9 15h4"/></svg>
              </div>
              <div>
                <p class="text-[11px] font-semibold text-white leading-none">Notion</p>
                <p class="text-[9px] text-gray-500 mt-0.5">Product Designer</p>
              </div>
            </div>
            <div class="flex items-center gap-2">
              <div class="flex-1 h-1 rounded-full bg-white/8 overflow-hidden">
                <div class="h-full w-[94%] rounded-full bg-emerald-500"></div>
              </div>
              <span class="text-[10px] font-bold text-emerald-400">94%</span>
            </div>
          </div>

          <!-- ── Floating Card: Stripe Job Match ── -->
          <div class="absolute -left-6 top-40 rounded-2xl border border-white/10 p-3 w-44" style="background:#16181f;box-shadow:0 8px 32px rgba(0,0,0,0.5);animation:floatB 4s ease-in-out infinite">
            <div class="flex items-center gap-2.5 mb-2.5">
              <div class="w-7 h-7 rounded-lg flex items-center justify-center flex-shrink-0" style="background:#1a1a35">
                <svg class="w-3.5 h-3.5 text-violet-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"/></svg>
              </div>
              <div>
                <p class="text-[11px] font-semibold text-white leading-none">Stripe</p>
                <p class="text-[9px] text-gray-500 mt-0.5">UX Lead · Remote</p>
              </div>
            </div>
            <div class="flex items-center gap-2">
              <div class="flex-1 h-1 rounded-full bg-white/8 overflow-hidden">
                <div class="h-full w-[88%] rounded-full bg-violet-500"></div>
              </div>
              <span class="text-[10px] font-bold text-violet-400">88%</span>
            </div>
          </div>

          <!-- ── Floating Card: Interview Reminder ── -->
          <div class="absolute -right-4 bottom-8 rounded-2xl border border-white/10 p-3 flex items-center gap-2.5" style="background:#16181f;box-shadow:0 8px 32px rgba(0,0,0,0.5);animation:floatA 3s ease-in-out infinite;animation-delay:0.5s">
            <div class="w-7 h-7 rounded-full flex items-center justify-center flex-shrink-0 font-bold text-[10px] text-white" style="background:linear-gradient(135deg,#6366f1,#8b5cf6)">JD</div>
            <div>
              <p class="text-[11px] font-semibold text-white leading-none">Google · Interview</p>
              <p class="text-[9px] text-gray-500 mt-0.5">Tomorrow, 10:00 AM</p>
            </div>
            <div class="ml-1 px-2 py-0.5 rounded-full border text-[9px] font-semibold" style="background:rgba(245,158,11,0.1);border-color:rgba(245,158,11,0.25);color:#fbbf24">Soon</div>
          </div>

        </div>
      </div>
    </div>
  </div>

  <!-- Scroll cue -->
  <div class="flex justify-center pb-8">
    <div class="flex flex-col items-center gap-2 text-gray-700 animate-bounce" style="animation-duration:2s">
      <span class="text-[10px] tracking-[0.2em] uppercase font-medium">Scroll</span>
      <svg xmlns="http://www.w3.org/2000/svg" class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m6 9 6 6 6-6"/></svg>
    </div>
  </div>

</section>

<!-- Font import (add to your layout <head> if not already there) -->
<!-- <link rel="preconnect" href="https://fonts.googleapis.com"> -->
<!-- <link href="https://fonts.googleapis.com/css2?family=Sora:wght@400;500;600;700&display=swap" rel="stylesheet"> -->

<style>
  @keyframes floatA {
    0%, 100% { transform: translateY(0px); }
    50%       { transform: translateY(-10px); }
  }
  @keyframes floatB {
    0%, 100% { transform: translateY(0px); }
    50%       { transform: translateY(-7px); }
  }
  .score-arc {
    transition: stroke-dashoffset 1.2s cubic-bezier(0.4,0,0.2,1);
  }
</style>