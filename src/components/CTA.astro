---
interface Props {
  title: string;
  subtitle: string;
  primaryCta: string;
  secondaryCta: string;
}

const { title, subtitle, primaryCta, secondaryCta } = Astro.props;
---

<section class="py-24 px-4 sm:px-6 lg:px-8">
  <div class="max-w-5xl mx-auto relative overflow-hidden bg-gradient-to-br from-emerald-500/20 via-zinc-900 to-black border border-white/10 rounded-[3rem] p-12 md:p-20 text-center">
    <!-- Glow behind -->
    <div class="absolute inset-0 bg-emerald-500/5 blur-[120px] pointer-events-none"></div>

    <div class="relative z-10">
      <h2 class="text-4xl md:text-6xl font-black text-white mb-8 tracking-tight">{title}</h2>
      <p class="text-gray-400 text-lg md:text-xl max-w-2xl mx-auto mb-12 font-medium leading-relaxed">
        {subtitle}
      </p>

      <div class="flex flex-col sm:flex-row items-center justify-center gap-6">
        <a href="/dashboard" class="w-full sm:w-auto px-10 py-5 bg-emerald-500 hover:bg-emerald-400 text-black font-black rounded-full transition-all transform hover:scale-110 active:scale-95 shadow-[0_0_30px_rgba(16,185,129,0.4)]">
          {primaryCta}
        </a>
        <button class="w-full sm:w-auto px-10 py-5 border border-white/20 hover:border-white/40 hover:bg-white/5 font-bold rounded-full text-white transition-all transform hover:scale-105">
          {secondaryCta}
        </button>
      </div>
      
      <p class="mt-8 text-gray-500 text-sm font-medium">No credit card required • 14-day free trial of Pro</p>
    </div>
  </div>
</section>
