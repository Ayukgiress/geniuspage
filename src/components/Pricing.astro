---
const pricing = [
  {
    name: "Free",
    price: "0",
    features: [
      "Basic Resume Scan",
      "3 Job Matches per Month",
      "Email Support",
      "Resume Score Checker"
    ],
    cta: "Join Waitlist",
    popular: false
  },
  {
    name: "Pro",
    price: "19",
    features: [
      "Unlimited AI Optimization",
      "Priority Job Matching",
      "Career Coaching Access",
      "Custom Cover Letters",
      "Interview Simulator"
    ],
    cta: "Get Early Access",
    popular: true
  }
];
---

<section id="pricing" class="py-24 relative overflow-hidden">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center mb-16">
    <h2 class="text-3xl md:text-5xl font-bold mb-6 tracking-tight">Simple, Transparent Pricing</h2>
    <div class="w-16 h-1 bg-emerald-500 mx-auto mb-6 rounded-full"></div>
    <p class="text-gray-400 text-lg max-w-2xl mx-auto leading-relaxed">
      Choose the plan that fits your career goals. Launch pricing - lock in your rate.
    </p>
  </div>

  <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 md:grid-cols-2 gap-8 items-center">
      {pricing.map((plan) => (
        <div class={`relative p-1 rounded-3xl transition-all duration-300 ${plan.popular ? 'bg-gradient-to-b from-emerald-400/50 to-emerald-600/50 scale-105 z-10' : 'bg-white/5 border border-white/10'}`}>
          {plan.popular && (
            <div class="absolute -top-4 left-1/2 -translate-x-1/2 bg-emerald-500 text-black text-xs font-black px-4 py-1.5 rounded-full uppercase tracking-widest">
              Launch Special
            </div>
          )}
          
          <div class={`h-full bg-zinc-950 p-8 md:p-12 rounded-[22px] flex flex-col`}>
            <div class="mb-8">
              <h3 class="text-xl font-bold text-white mb-2">{plan.name}</h3>
              <div class="flex items-baseline gap-1">
                <span class="text-4xl font-black text-white">${plan.price}</span>
                <span class="text-gray-500 text-sm">/month</span>
              </div>
            </div>

            <ul class="space-y-4 mb-10 flex-1">
              {plan.features.map((feature) => (
                <li class="flex items-center gap-3 text-gray-300 text-sm md:text-base">
                  <div class="w-5 h-5 bg-emerald-500/10 rounded-full flex items-center justify-center shrink-0">
                    <svg xmlns="http://www.w3.org/2000/svg" class="w-3.5 h-3.5 text-emerald-500" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
                  </div>
                  {feature}
                </li>
              ))}
            </ul>

            <button class={`w-full py-4 rounded-full font-bold transition-all transform hover:scale-[1.02] active:scale-95 ${plan.popular ? 'bg-emerald-500 text-black hover:bg-emerald-400 shadow-[0_0_20px_rgba(16,185,129,0.3)]' : 'bg-white/5 text-white border border-white/10 hover:bg-white/10'}`}>
              {plan.cta}
            </button>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
