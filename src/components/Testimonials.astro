---
const testimonials = [
  {
    quote: "This tool helped me identify exactly what recruiters were looking for. The AI suggestions were incredibly accurate.",
    author: "Beta Tester",
    role: "Early Access User",
    avatar: "https://i.pravatar.cc/150?u=beta1"
  },
  {
    quote: "The resume scoring feature is spot-on. I improved my score by 25 points in just one sitting.",
    author: "Beta Tester",
    role: "Early Access User", 
    avatar: "https://i.pravatar.cc/150?u=beta2"
  },
  {
    quote: "Finally, a tool that combines job tracking with resume optimization. Can't wait for the full release!",
    author: "Beta Tester",
    role: "Early Access User",
    avatar: "https://i.pravatar.cc/150?u=beta3"
  }
];
---

<section id="testimonials" class="py-24 bg-black">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center mb-16">
    <h2 class="text-3xl md:text-5xl font-bold mb-6 tracking-tight">What Early Users Say</h2>
    <div class="w-16 h-1 bg-emerald-500 mx-auto mb-6 rounded-full"></div>
    <p class="text-gray-400 text-lg max-w-2xl mx-auto leading-relaxed">
      Join our early access community and be the first to experience the future of job hunting.
    </p>
  </div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
      {testimonials.map((testimonial) => (
        <div class="bg-zinc-900/50 border border-white/5 p-8 rounded-3xl flex flex-col justify-between hover:border-emerald-500/30 transition-all">
          <p class="text-gray-300 italic mb-8 leading-relaxed">
            "{testimonial.quote}"
          </p>
          <div class="flex items-center gap-4">
            <img 
              src={testimonial.avatar} 
              alt={testimonial.author} 
              class="w-12 h-12 rounded-full border border-white/10"
            />
            <div>
              <div class="font-bold text-white">{testimonial.author}</div>
              <div class="text-xs text-emerald-500 font-medium">{testimonial.role}</div>
            </div>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
