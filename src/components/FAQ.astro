---
const faqs = [
  {
    question: "How does the AI resume analysis work?",
    answer: "Our advanced AI scans your resume against industry-specific keywords, formatting standards, and ATS (Applicant Tracking System) requirements. It provides a detailed score and actionable suggestions to improve your chances of getting noticed by recruiters."
  },
  {
    question: "Is my data secure?",
    answer: "Absolutely. We use bank-level encryption to protect your personal information. Your resume and job application data are never shared with third parties without your explicit consent."
  },
  {
    question: "Can I use the free version indefinitely?",
    answer: "Yes! Our free tier gives you access to basic resume analysis and limited job tracking. You can upgrade to Premium anytime to unlock unlimited applications, advanced analytics, and priority support."
  },
  {
    question: "How accurate is the job matching?",
    answer: "Our matching algorithm considers over 50 data points including skills, experience level, location preferences, and career goals. Users report a 92% satisfaction rate with the relevance of job recommendations."
  },
  {
    question: "Do you offer support for career changers?",
    answer: "Yes! Our AI is specially designed to identify transferable skills and highlight them for roles outside your original field. We also provide personalized learning paths to help you bridge any skill gaps."
  }
];
---

<section class="py-24 bg-zinc-950 relative overflow-hidden">
  <!-- Background decoration -->
  <div class="absolute inset-0 opacity-30">
    <div class="absolute top-20 left-10 w-72 h-72 bg-emerald-500/10 rounded-full blur-3xl"></div>
    <div class="absolute bottom-20 right-10 w-96 h-96 bg-emerald-500/5 rounded-full blur-3xl"></div>
  </div>

  <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 relative">
    <div class="text-center mb-16">
      <span class="inline-block px-4 py-1.5 rounded-full bg-emerald-500/10 text-emerald-400 text-sm font-medium mb-4 border border-emerald-500/20">
        FAQ
      </span>
      <h2 class="text-3xl md:text-5xl font-bold mb-6 tracking-tight text-white">
        Frequently Asked Questions
      </h2>
      <p class="text-gray-400 text-lg leading-relaxed max-w-xl mx-auto">
        Everything you need to know about our platform. Can't find the answer you're looking for? Contact our support team.
      </p>
    </div>

    <div class="space-y-3">
      {faqs.map((faq, index) => (
        <div class="faq-item group" data-index={index}>
          <button 
            class="faq-trigger w-full bg-zinc-900/80 border border-white/5 rounded-2xl p-6 text-left hover:border-emerald-500/30 transition-all duration-300 focus:outline-none focus:ring-2 focus:ring-emerald-500/50"
            aria-expanded="false"
            aria-controls={`faq-content-${index}`}
          >
            <div class="flex items-start justify-between gap-4">
              <div class="flex items-start gap-4">
                <span class="flex-shrink-0 w-8 h-8 rounded-lg bg-emerald-500/10 text-emerald-400 flex items-center justify-center text-sm font-semibold">
                  {String(index + 1).padStart(2, '0')}
                </span>
                <h3 class="text-lg font-semibold text-white group-hover:text-emerald-400 transition-colors">
                  {faq.question}
                </h3>
              </div>
              <span class="faq-icon flex-shrink-0 w-6 h-6 rounded-full bg-zinc-800 flex items-center justify-center transition-transform duration-300 group-hover:bg-emerald-500/20">
                <svg class="w-3 h-3 text-gray-400 group-hover:text-emerald-400 transition-transform duration-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6v12m0 0l-6-6m6 6l6-6" />
                </svg>
              </span>
            </div>
          </button>
          <div 
            id={`faq-content-${index}`}
            class="faq-content overflow-hidden max-h-0 transition-all duration-500 ease-out"
          >
            <div class="px-6 pb-6">
              <div class="pl-12">
                <p class="text-gray-400 leading-relaxed text-sm md:text-base">
                  {faq.answer}
                </p>
              </div>
            </div>
          </div>
        </div>
      ))}
    </div>

    <!-- Contact CTA -->
    <div class="mt-12 text-center">
      <p class="text-gray-400">
        Still have questions? 
        <a href="#" class="text-emerald-400 hover:text-emerald-300 font-medium transition-colors underline underline-offset-4">
          Contact our support team
        </a>
      </p>
    </div>
  </div>
</section>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const faqItems = document.querySelectorAll('.faq-item');
    
    faqItems.forEach((item) => {
      const trigger = item.querySelector('.faq-trigger');
      const content = item.querySelector('.faq-content');
      const icon = item.querySelector('.faq-icon svg');
      
      trigger?.addEventListener('click', () => {
        const isExpanded = trigger.getAttribute('aria-expanded') === 'true';
        
        // Close all other FAQs
        faqItems.forEach((otherItem) => {
          const otherTrigger = otherItem.querySelector('.faq-trigger');
          const otherContent = otherItem.querySelector('.faq-content');
          const otherIcon = otherItem.querySelector('.faq-icon svg');
          
          if (otherItem !== item) {
            otherTrigger?.setAttribute('aria-expanded', 'false');
            otherContent?.setAttribute('style', 'max-height: 0');
            otherIcon?.setAttribute('style', 'transform: rotate(0deg)');
          }
        });
        
        // Toggle current FAQ
        if (isExpanded) {
          trigger.setAttribute('aria-expanded', 'false');
          content?.setAttribute('style', 'max-height: 0');
          icon?.setAttribute('style', 'transform: rotate(0deg)');
        } else {
          trigger.setAttribute('aria-expanded', 'true');
          const scrollHeight = content?.scrollHeight || 0;
          content?.setAttribute('style', `max-height: ${scrollHeight}px`);
          icon?.setAttribute('style', 'transform: rotate(45deg)');
        }
      });
    });
  });
</script>

<style>
  .faq-trigger:focus {
    outline: none;
  }
  
  .faq-trigger:focus-visible {
    outline: 2px solid rgb(16 185 129 / 0.5);
    outline-offset: 2px;
  }
</style>
