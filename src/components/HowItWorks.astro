---
const steps = [
  {
    title: "Upload Resume",
    description: "Drag and drop your PDF. Our AI parses your experience instantly.",
    icon: "upload"
  },
  {
    title: "AI Analysis",
    description: "Receive real-time optimizations and tailored keywords for your target role.",
    icon: "analysis"
  },
  {
    title: "Apply with Confidence",
    description: "One-click applications to high-match jobs directly from your dashboard.",
    icon: "rocket"
  }
];
---

<section id="how-it-works" class="py-24 bg-zinc-950">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center mb-20">
    <h2 class="text-3xl md:text-5xl font-bold mb-6 tracking-tight text-white">How it Works</h2>
    <p class="text-gray-400 text-lg max-w-2xl mx-auto leading-relaxed">
      Get your dream job in three simple steps with our intelligent assistant.
    </p>
  </div>

  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 relative">
    <!-- Connecting Line -->
    <div class="hidden md:block absolute top-10 left-[15%] right-[15%] h-0.5 bg-gradient-to-r from-emerald-500/0 via-emerald-500/50 to-emerald-500/0 z-0"></div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-12 text-center">
      {steps.map((step, index) => (
        <div class="relative z-10 flex flex-col items-center">
          <div class="w-20 h-20 bg-emerald-500/10 rounded-2xl flex items-center justify-center mb-8 border border-white/5 group-hover:border-emerald-500 transition-all">
            {step.icon === "upload" && (
                <svg xmlns="http://www.w3.org/2000/svg" class="w-10 h-10 text-emerald-500" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="17 8 12 3 7 8"/><line x1="12" x2="12" y1="3" y2="15"/></svg>
            )}
            {step.icon === "analysis" && (
                <svg xmlns="http://www.w3.org/2000/svg" class="w-10 h-10 text-emerald-500" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14.5 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7.5L14.5 2z"/><polyline points="14.5 2 14.5 7 20 7"/><path d="M12 11v6"/><path d="M9 14h6"/></svg>
            )}
            {step.icon === "rocket" && (
                <svg xmlns="http://www.w3.org/2000/svg" class="w-10 h-10 text-emerald-500" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m2 22 1-1c1-1 2.01-1 3-1h.5a3.7 3.7 0 0 0 2.4-1l11.2-11.2a3.1 3.1 0 1 0-4.4-4.4L3.5 15.6a3.7 3.7 0 0 0-1 2.4V18.5c0 .99 0 2-1 3l-1 1"/><path d="m15 8 4 4"/></svg>
            )}
          </div>
          <h3 class="text-xl font-bold mb-4 text-white">{step.title}</h3>
          <p class="text-gray-400 leading-relaxed max-w-xs">
            {step.description}
          </p>
        </div>
      ))}
    </div>
  </div>
</section>
