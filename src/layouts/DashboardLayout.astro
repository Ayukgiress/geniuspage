---
import "../styles/global.css";

interface Props {
	title?: string;
}

const { title = "Dashboard | Genius" } = Astro.props;

const sidebarItems = [
	{ name: "Overview", icon: "layout", href: "/dashboard" },
	{ name: "Applications", icon: "briefcase", href: "/dashboard/applications" },
	{ name: "Resumes", icon: "file-text", href: "/dashboard/resumes" },
	{ name: "Skills", icon: "award", href: "/dashboard/skills" },
	{ name: "Settings", icon: "settings", href: "/dashboard/settings" },
];
---

<!doctype html>
<html lang="en" class="h-full bg-black">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
	</head>
	<body class="h-full text-white font-sans antialiased overflow-hidden">
		<div class="flex h-full">
			<!-- Sidebar -->
			<aside class="hidden md:flex flex-col w-64 bg-zinc-950 border-r border-white/5 h-full">
				<div class="p-6 flex items-center gap-3">
					<div class="w-8 h-8 bg-emerald-500 rounded-lg flex items-center justify-center">
						<svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 text-black" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m12 3-1.912 5.813a2 2 0 0 1-1.275 1.275L3 12l5.813 1.912a2 2 0 0 1 1.275 1.275L12 21l1.912-5.813a2 2 0 0 1 1.275-1.275L21 12l-5.813-1.912a2 2 0 0 1-1.275-1.275L12 3Z"/></svg>
					</div>
					<span class="text-xl font-bold tracking-tight">Genius</span>
				</div>

				<nav class="flex-1 px-4 py-4 space-y-1 overflow-y-auto">
					{sidebarItems.map((item) => (
						<a
							href={item.href}
							class="flex items-center gap-3 px-4 py-3 text-sm font-medium rounded-xl transition-all duration-200 group hover:bg-white/5 text-gray-400 hover:text-white"
						>
							<div class="p-1 rounded-md bg-white/5 group-hover:bg-emerald-500/10 group-hover:text-emerald-500 transition-colors">
								{item.icon === "layout" && (
									<svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="18" height="18" x="3" y="3" rx="2" ry="2"/><line x1="3" x2="21" y1="9" y2="9"/><line x1="9" x2="9" y1="21" y2="9"/></svg>
								)}
								{item.icon === "briefcase" && (
									<svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="20" height="14" x="2" y="7" rx="2" ry="2"/><path d="M16 21V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v16"/></svg>
								)}
								{item.icon === "file-text" && (
									<svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14.5 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7.5L14.5 2z"/><polyline points="14 2 14 8 20 8"/></svg>
								)}
								{item.icon === "award" && (
									<svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="8" r="7"/><polyline points="8.21 13.89 7 23 12 20 17 23 15.79 13.88"/></svg>
								)}
								{item.icon === "settings" && (
									<svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12.22 2h-.44a2 2 0 0 0-2 2v.18a2 2 0 0 1-1 1.73l-.43.25a2 2 0 0 1-2 0l-.15-.08a2 2 0 0 0-2.73.73l-.22.38a2 2 0 0 0 .73 2.73l.15.1a2 2 0 0 1 1 1.72v.51a2 2 0 0 1-1 1.74l-.15.09a2 2 0 0 0-.73 2.73l.22.38a2 2 0 0 0 2.73.73l.15-.08a2 2 0 0 1 2 0l.43.25a2 2 0 0 1 1 1.73V20a2 2 0 0 0 2 2h.44a2 2 0 0 0 2-2v-.18a2 2 0 0 1 1-1.73l.43-.25a2 2 0 0 1 2 0l.15.08a2 2 0 0 0 2.73-.73l.22-.39a2 2 0 0 0-.73-2.73l-.15-.1a2 2 0 0 1-1-1.72v-.51a2 2 0 0 1 1-1.74l.15-.09a2 2 0 0 0 .73-2.73l-.22-.38a2 2 0 0 0-2.73-.73l-.15.08a2 2 0 0 1-2 0l-.43-.25a2 2 0 0 1-1-1.73V4a2 2 0 0 0-2-2z"/><circle cx="12" cy="12" r="3"/></svg>
								)}
							</div>
							{item.name}
						</a>
					))}
				</nav>

				<div class="p-4 border-t border-white/5">
					<div class="bg-gradient-to-br from-emerald-500/10 to-emerald-600/5 rounded-2xl p-4 border border-emerald-500/20">
						<h4 class="text-xs font-semibold text-emerald-500 uppercase tracking-wider mb-2">Pro Plan</h4>
						<p class="text-xs text-gray-400 mb-4 leading-relaxed">Unlock unlimited AI resume optimizations and job tracking features.</p>
						<button class="w-full py-2 bg-emerald-500 text-black text-xs font-bold rounded-lg hover:bg-emerald-400 transition-colors">Upgrade Now</button>
					</div>
				</div>
			</aside>

			<!-- Main Content Wrapper -->
			<div class="flex-1 flex flex-col h-full bg-black overflow-hidden relative">
                <!-- Top Navbar -->
                <header class="h-16 border-b border-white/5 flex items-center justify-between px-8 bg-zinc-950/50 backdrop-blur-md sticky top-0 z-30">
                    <div class="flex items-center gap-4">
                        <h2 class="text-lg font-semibold text-white">{title.split(' | ')[0]}</h2>
                    </div>

                    <div class="flex items-center gap-6">
                        <!-- Notifications -->
                        <button class="text-gray-400 hover:text-white transition-colors relative">
                            <span class="absolute -top-1 -right-1 w-2 h-2 bg-emerald-500 rounded-full"></span>
                            <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M6 8a6 6 0 0 1 12 0c0 7 3 9 3 9H3s3-2 3-9"/><path d="M10.3 21a1.94 1.94 0 0 0 3.4 0"/></svg>
                        </button>

                        <!-- Profile -->
                        <div class="flex items-center gap-3 pl-6 border-l border-white/10">
                            <div class="text-right">
                                <p class="text-xs font-medium text-white">Alex Johnson</p>
                                <p class="text-[10px] text-gray-400">Software Engineer</p>
                            </div>
                            <div class="w-8 h-8 rounded-full bg-gradient-to-br from-emerald-500 to-teal-600 border border-white/10"></div>
                        </div>
                    </div>
                </header>

                <!-- Page Content -->
                <main class="flex-1 overflow-y-auto p-8 relative">
                    <!-- Subtle background glow -->
                    <div class="absolute top-0 right-0 w-[400px] h-[400px] bg-emerald-500/5 blur-[120px] rounded-full -z-10 pointer-events-none"></div>
                    
                    <slot />
                </main>
			</div>
		</div>
	</body>
</html>

<style is:global>
	::-webkit-scrollbar {
		width: 4px;
	}
	::-webkit-scrollbar-track {
		background: transparent;
	}
	::-webkit-scrollbar-thumb {
		background: rgba(255, 255, 255, 0.05);
		border-radius: 10px;
	}
	::-webkit-scrollbar-thumb:hover {
		background: rgba(255, 255, 255, 0.1);
	}
</style>
