---
import DashboardLayout from '../../layouts/DashboardLayout.astro';

const resumes = [
	{ id: 1, name: 'Senior Developer - Vercel Optimized', date: '2 hours ago', score: 92, variants: 3, type: 'PDF' },
	{ id: 2, name: 'Product Designer - General', date: '5 days ago', score: 85, variants: 1, type: 'DOCX' },
	{ id: 3, name: 'Full Stack Engineer - Tech Startup', date: '1 week ago', score: 88, variants: 2, type: 'PDF' },
];
---

<DashboardLayout title="Resumes | Genius">
	<div class="flex items-center justify-between mb-8">
		<div>
			<h1 class="text-3xl font-bold text-white mb-2">Resume Management</h1>
			<p class="text-gray-400">Manage and optimize your resumes for every role.</p>
		</div>
		<div class="flex gap-4">
			<button class="px-6 py-3 bg-white/5 border border-white/10 text-white font-semibold rounded-xl hover:bg-white/10 transition-all flex items-center gap-2">
				<svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" x2="12" y1="3" y2="15"/></svg>
				Import Resume
			</button>
			<button class="px-6 py-3 bg-emerald-500 text-black font-bold rounded-xl hover:bg-emerald-400 transition-all flex items-center gap-2">
				<svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
				Create New
			</button>
		</div>
	</div>

	<!-- AI Score Stats -->
	<div class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-12">
		<div class="bg-gradient-to-br from-emerald-500/10 to-emerald-600/5 border border-emerald-500/20 rounded-2xl p-6">
			<h3 class="text-emerald-400 font-semibold mb-2">Average ATS Score</h3>
			<p class="text-4xl font-bold text-white mb-4">88<span class="text-lg text-emerald-500/50">/100</span></p>
			<div class="w-full bg-white/5 rounded-full h-1.5 overflow-hidden">
				<div class="bg-emerald-500 h-full w-[88%] rounded-full"></div>
			</div>
		</div>
		<div class="bg-zinc-900/50 border border-white/5 rounded-2xl p-6">
			<h3 class="text-gray-400 font-semibold mb-2">Variants Created</h3>
			<p class="text-4xl font-bold text-white mb-4">12</p>
			<p class="text-xs text-gray-500 font-medium">+3 this month</p>
		</div>
		<div class="bg-zinc-900/50 border border-white/5 rounded-2xl p-6">
			<h3 class="text-gray-400 font-semibold mb-2">Most Matched Skill</h3>
			<p class="text-4xl font-bold text-white mb-4 uppercase text-lg tracking-wider">React.js</p>
			<p class="text-xs text-emerald-500 font-medium">98% Match Rate</p>
		</div>
	</div>

	<!-- Resumes Table -->
	<div class="bg-zinc-900/50 border border-white/5 rounded-2xl overflow-hidden">
		<div class="p-6 border-b border-white/5 flex items-center justify-between">
			<h3 class="font-bold text-white">Your Resumes</h3>
			<div class="flex gap-2">
				<div class="relative">
					<input type="text" placeholder="Search resumes..." class="bg-white/5 border border-white/10 rounded-lg px-4 py-2 pl-10 text-sm focus:outline-none focus:border-emerald-500/50 transition-colors" />
					<svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 text-gray-500 absolute left-3 top-1/2 -translate-y-1/2" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.3-4.3"/></svg>
				</div>
			</div>
		</div>
		<div class="overflow-x-auto">
			<table class="w-full text-left">
				<thead>
					<tr class="text-xs font-semibold text-gray-500 uppercase tracking-wider border-b border-white/5">
						<th class="px-8 py-4">Name</th>
						<th class="px-8 py-4">Status</th>
						<th class="px-8 py-4 text-center">ATS Score</th>
						<th class="px-8 py-4">Last Modified</th>
						<th class="px-8 py-4"></th>
					</tr>
				</thead>
				<tbody class="divide-y divide-white/5">
					{resumes.map((resume) => (
						<tr class="group hover:bg-white/[0.02] transition-colors">
							<td class="px-8 py-6">
								<div class="flex items-center gap-4">
									<div class="w-10 h-10 bg-emerald-500/10 rounded-lg flex items-center justify-center text-emerald-500 group-hover:bg-emerald-500/20 transition-colors">
										<svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M14.5 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7.5L14.5 2z"/><polyline points="14 2 14 8 20 8"/></svg>
									</div>
									<div>
										<h4 class="text-sm font-semibold text-white mb-1">{resume.name}</h4>
										<p class="text-xs text-gray-500">{resume.variants} variants • {resume.type}</p>
									</div>
								</div>
							</td>
							<td class="px-8 py-6">
								<span class="px-2.5 py-1 bg-emerald-500/10 text-emerald-500 border border-emerald-500/20 rounded-full text-[10px] font-bold uppercase tracking-wider">Optimized</span>
							</td>
							<td class="px-8 py-6">
								<div class="flex items-center justify-center gap-2">
									<div class="w-12 h-1.5 bg-white/5 rounded-full overflow-hidden">
										<div class={`h-full rounded-full ${resume.score > 90 ? 'bg-emerald-500' : 'bg-yellow-500'}`} style={`width: ${resume.score}%`}></div>
									</div>
									<span class="text-xs font-bold text-white">{resume.score}</span>
								</div>
							</td>
							<td class="px-8 py-6 text-sm text-gray-400">{resume.date}</td>
							<td class="px-8 py-6 text-right">
								<div class="flex items-center justify-end gap-3 opacity-0 group-hover:opacity-100 transition-opacity">
									<button class="p-2 bg-white/5 border border-white/10 rounded-lg text-gray-400 hover:text-white hover:bg-white/10 transition-all">
										<svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"/></svg>
									</button>
									<button class="p-2 bg-white/5 border border-white/10 rounded-lg text-gray-400 hover:text-white hover:bg-white/10 transition-all">
										<svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="1"/><circle cx="12" cy="5" r="1"/><circle cx="12" cy="19" r="1"/></svg>
									</button>
								</div>
							</td>
						</tr>
					))}
				</tbody>
			</table>
		</div>
	</div>
</DashboardLayout>
