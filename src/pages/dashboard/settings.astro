---
import DashboardLayout from '../../layouts/DashboardLayout.astro';

const sections = [
	{ id: 'profile', name: 'Profile', icon: 'user' },
	{ id: 'notifications', name: 'Notifications', icon: 'bell' },
	{ id: 'billing', name: 'Billing', icon: 'credit-card' },
	{ id: 'api', name: 'AI & API Settings', icon: 'zap' },
];
---

<DashboardLayout title="Settings | Genius">
	<div class="mb-8">
		<h1 class="text-3xl font-bold text-white mb-2">Settings</h1>
		<p class="text-gray-400">Manage your account preferences and integrations.</p>
	</div>

	<div class="grid grid-cols-1 lg:grid-cols-4 gap-8">
		<!-- Sidebar Links -->
		<div class="lg:col-span-1 space-y-2">
			{sections.map((section) => (
				<button class={`w-full flex items-center gap-3 px-6 py-4 rounded-2xl transition-all duration-200 group text-left ${
					section.id === 'profile' ? 'bg-emerald-500 text-black font-bold shadow-lg shadow-emerald-500/20' : 'bg-zinc-900/50 text-gray-400 hover:bg-white/5 border border-white/5'
				}`}>
					<div class={`p-1.5 rounded-lg ${section.id === 'profile' ? 'bg-black/10' : 'bg-white/5 group-hover:bg-emerald-500/10 transition-colors'}`}>
						{section.icon === 'user' && (
							<svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M19 21v-2a4 4 0 0 0-4-4H9a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
						)}
						{section.icon === 'bell' && (
							<svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M6 8a6 6 0 0 1 12 0c0 7 3 9 3 9H3s3-2 3-9"/><path d="M10.3 21a1.94 1.94 0 0 0 3.4 0"/></svg>
						)}
						{section.icon === 'credit-card' && (
							<svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><rect width="20" height="14" x="2" y="5" rx="2"/><line x1="2" x2="22" y1="10" y2="10"/></svg>
						)}
						{section.icon === 'zap' && (
							<svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"/></svg>
						)}
					</div>
					<span class="text-sm tracking-tight">{section.name}</span>
				</button>
			))}
		</div>

		<!-- Settings Content -->
		<div class="lg:col-span-3 space-y-8">
			<div class="bg-zinc-900/50 border border-white/5 rounded-3xl p-8">
				<h3 class="text-xl font-bold text-white mb-8 pb-4 border-b border-white/5">Profile Information</h3>
				
				<div class="grid grid-cols-1 md:grid-cols-2 gap-8 mb-12">
					<div class="space-y-2">
						<label class="text-xs font-bold text-gray-500 uppercase tracking-widest ml-1">Full Name</label>
						<input type="text" value="Alex Johnson" class="w-full bg-white/5 border border-white/10 rounded-xl px-4 py-3 text-white focus:outline-none focus:border-emerald-500/50 transition-colors" />
					</div>
					<div class="space-y-2">
						<label class="text-xs font-bold text-gray-500 uppercase tracking-widest ml-1">Email Address</label>
						<input type="email" value="alex@example.com" class="w-full bg-white/5 border border-white/10 rounded-xl px-4 py-3 text-white focus:outline-none focus:border-emerald-500/50 transition-colors" />
					</div>
					<div class="space-y-2">
						<label class="text-xs font-bold text-gray-500 uppercase tracking-widest ml-1">Job Title</label>
						<input type="text" value="Software Engineer" class="w-full bg-white/5 border border-white/10 rounded-xl px-4 py-3 text-white focus:outline-none focus:border-emerald-500/50 transition-colors" />
					</div>
					<div class="space-y-2">
						<label class="text-xs font-bold text-gray-500 uppercase tracking-widest ml-1">LinkedIn Profile</label>
						<input type="url" value="https://linkedin.com/in/alexjohnson" class="w-full bg-white/5 border border-white/10 rounded-xl px-4 py-3 text-white focus:outline-none focus:border-emerald-500/50 transition-colors" />
					</div>
				</div>

				<div class="flex items-center gap-4 pt-4 border-t border-white/5">
					<button class="px-8 py-3 bg-emerald-500 text-black font-bold rounded-xl hover:bg-emerald-400 transition-all text-sm">Save Changes</button>
					<button class="px-8 py-3 bg-white/5 border border-white/10 text-white font-bold rounded-xl hover:bg-white/10 transition-all text-sm">Cancel</button>
				</div>
			</div>

			<div class="bg-zinc-900/50 border border-white/5 rounded-3xl p-8">
				<h3 class="text-xl font-bold text-white mb-8 pb-4 border-b border-white/5">Email Notifications</h3>
				<div class="space-y-6">
					<div class="flex items-center justify-between">
						<div>
							<h4 class="text-sm font-bold text-white mb-1">New Application Response</h4>
							<p class="text-xs text-gray-500">Get notified when a company responds to your application.</p>
						</div>
						<div class="w-12 h-6 bg-emerald-500 rounded-full relative cursor-pointer shadow-inner">
							<div class="absolute right-1 top-1 w-4 h-4 bg-white rounded-full"></div>
						</div>
					</div>
					<div class="flex items-center justify-between border-t border-white/5 pt-6">
						<div>
							<h4 class="text-sm font-bold text-white mb-1">AI Resume Suggestions</h4>
							<p class="text-xs text-gray-500">Weekly tips to improve your profile based on market trends.</p>
						</div>
						<div class="w-12 h-6 bg-emerald-500 rounded-full relative cursor-pointer shadow-inner">
							<div class="absolute right-1 top-1 w-4 h-4 bg-white rounded-full"></div>
						</div>
					</div>
					<div class="flex items-center justify-between border-t border-white/5 pt-6">
						<div>
							<h4 class="text-sm font-bold text-white mb-1">Weekly Market Pulse</h4>
							<p class="text-xs text-gray-500">A summary of job market changes in your industry.</p>
						</div>
						<div class="w-12 h-6 bg-white/10 border border-white/10 rounded-full relative cursor-pointer">
							<div class="absolute left-1 top-1 w-4 h-4 bg-gray-500 rounded-full"></div>
						</div>
					</div>
				</div>
			</div>

			<div class="bg-red-500/5 border border-red-500/20 rounded-3xl p-8">
				<h3 class="text-xl font-bold text-red-500 mb-2">Danger Zone</h3>
				<p class="text-gray-500 text-xs mb-8">Permanently delete your account and all associated data. This action cannot be undone.</p>
				<button class="px-8 py-3 bg-red-500/10 border border-red-500/30 text-red-500 font-bold rounded-xl hover:bg-red-500 hover:text-white transition-all text-sm">Delete Account</button>
			</div>
		</div>
	</div>
</DashboardLayout>
