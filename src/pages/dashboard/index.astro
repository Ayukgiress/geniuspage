---
import DashboardLayout from '../../layouts/DashboardLayout.astro';

const stats = [
	{ name: 'Total Applications', value: '42', change: '+5', icon: 'briefcase', trend: 'up' },
	{ name: 'Interviews Scheduled', value: '8', change: '+2', icon: 'calendar', trend: 'up' },
	{ name: 'Resume Score', value: '92', change: '+12', icon: 'star', trend: 'up' },
	{ name: 'Skill Match', value: '78%', change: '-2%', icon: 'award', trend: 'down' },
];

const recentActivity = [
	{ id: 1, type: 'Application', title: 'Senior Developer at Vercel', date: '2 hours ago', status: 'Applied' },
	{ id: 2, type: 'Interview', title: 'Product Manager at Stripe', date: '5 hours ago', status: 'Upcoming' },
	{ id: 3, type: 'Update', title: 'New Resume Optimized for AI Roles', date: '1 day ago', status: 'Completed' },
	{ id: 4, type: 'Rejection', title: 'Full Stack Engineer at Linear', date: '2 days ago', status: 'Closed' },
];
---

<DashboardLayout title="Overview | Genius">
	<!-- Top Welcome Row -->
	<div class="mb-8">
		<h1 class="text-3xl font-bold text-white mb-2">Welcome back, Alex! 👋</h1>
		<p class="text-gray-400">Here's what's happening with your job search today.</p>
	</div>

	<!-- Stats Grid -->
	<div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6 mb-8">
		{stats.map((stat) => (
			<div class="bg-zinc-900/50 border border-white/5 rounded-2xl p-6 hover:bg-zinc-800/50 transition-colors">
				<div class="flex items-center justify-between mb-4">
					<div class="p-2 bg-emerald-500/10 rounded-xl text-emerald-500">
						{stat.icon === 'briefcase' && (
							<svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect width="20" height="14" x="2" y="7" rx="2" ry="2"/><path d="M16 21V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v16"/></svg>
						)}
						{stat.icon === 'calendar' && (
							<svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect width="18" height="18" x="3" y="4" rx="2" ry="2"/><line x1="16" x2="16" y1="2" y2="6"/><line x1="8" x2="8" y1="2" y2="6"/><line x1="3" x2="21" y1="10" y2="10"/></svg>
						)}
						{stat.icon === 'star' && (
							<svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>
						)}
						{stat.icon === 'award' && (
							<svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="8" r="7"/><polyline points="8.21 13.89 7 23 12 20 17 23 15.79 13.88"/></svg>
						)}
					</div>
					<div class={`text-xs font-medium ${stat.trend === 'up' ? 'text-emerald-400' : 'text-red-400'} flex items-center gap-1`}>
						{stat.change}
						{stat.trend === 'up' ? (
							<svg xmlns="http://www.w3.org/2000/svg" class="w-3 h-3" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="18 15 12 9 6 15"/></svg>
						) : (
							<svg xmlns="http://www.w3.org/2000/svg" class="w-3 h-3" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="6 9 12 15 18 9"/></svg>
						)}
					</div>
				</div>
				<h3 class="text-sm font-medium text-gray-400 mb-1">{stat.name}</h3>
				<p class="text-2xl font-bold text-white tracking-tight">{stat.value}</p>
			</div>
		))}
	</div>

	<div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
		<!-- Activity List -->
		<div class="lg:col-span-2 bg-zinc-900/50 border border-white/5 rounded-2xl overflow-hidden flex flex-col">
			<div class="p-6 border-b border-white/5 flex items-center justify-between">
				<h3 class="font-bold text-white">Recent Activity</h3>
				<a href="/dashboard/applications" class="text-xs text-emerald-500 hover:text-emerald-400 transition-colors">View all</a>
			</div>
			<div class="flex-1 overflow-y-auto">
				{recentActivity.map((activity) => (
					<div class="p-6 flex items-center gap-4 hover:bg-white/5 transition-colors border-b border-white/5 last:border-0 group">
						<div class="w-12 h-12 rounded-xl bg-white/5 border border-white/10 flex items-center justify-center group-hover:border-emerald-500/30 transition-colors">
							{activity.type === 'Application' && (
								<svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6 text-gray-400 group-hover:text-emerald-500 transition-colors" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 2H2v10c0 5.5 4.5 10 10 10s10-4.5 10-10V2H12Z"/><path d="m9 12 2 2 4-4"/></svg>
							)}
							{activity.type === 'Interview' && (
								<svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6 text-gray-400 group-hover:text-emerald-500 transition-colors" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z"/><path d="M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z"/></svg>
							)}
							{activity.type === 'Update' && (
								<svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6 text-gray-400 group-hover:text-emerald-500 transition-colors" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" x2="12" y1="3" y2="15"/></svg>
							)}
                            {activity.type === 'Rejection' && (
                                <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6 text-gray-400 group-hover:text-red-500 transition-colors" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><line x1="15" y1="9" x2="9" y2="15"/><line x1="9" y1="9" x2="15" y2="15"/></svg>
                            )}
						</div>
						<div class="flex-1">
							<h4 class="text-sm font-semibold text-white">{activity.title}</h4>
							<p class="text-xs text-gray-500">{activity.date}</p>
						</div>
						<span class={`text-[10px] px-2.5 py-1 rounded-full border font-medium ${
							activity.status === 'Applied' ? 'bg-emerald-500/10 text-emerald-500 border-emerald-500/20' :
							activity.status === 'Upcoming' ? 'bg-blue-500/10 text-blue-500 border-blue-500/20' :
							activity.status === 'Completed' ? 'bg-purple-500/10 text-purple-500 border-purple-500/20' :
							'bg-gray-500/10 text-gray-400 border-white/10'
						}`}>
							{activity.status}
						</span>
					</div>
				))}
			</div>
		</div>

		<!-- AI Insights Sidebar -->
		<div class="flex flex-col gap-8">
			<div class="bg-gradient-to-br from-emerald-500 to-teal-600 rounded-3xl p-6 shadow-xl shadow-emerald-500/10">
				<div class="w-10 h-10 bg-white/20 rounded-xl flex items-center justify-center mb-6">
					<svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6 text-white" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 12a9 9 0 1 1-9-9c2.52 0 4.93 1 6.74 2.74L21 8"/><path d="M21 3v5h-5"/><path d="M12 7v5l3 2"/></svg>
				</div>
				<h3 class="text-xl font-bold text-white mb-2 tracking-tight">AI Interview Coach</h3>
				<p class="text-emerald-100 text-sm mb-6 leading-relaxed opacity-90">Ready to practice for your Stripe interview? I've prepared 5 behavioral questions based on the job description.</p>
				<button class="w-full py-3 bg-white text-emerald-600 font-bold rounded-xl hover:bg-emerald-50 transition-colors shadow-lg">Start Prep Session</button>
			</div>

			<div class="bg-zinc-900/50 border border-white/5 rounded-2xl p-6">
				<h3 class="font-bold text-white mb-4">Job Market Pulse</h3>
				<div class="space-y-4">
					<div class="flex items-center justify-between text-xs">
						<span class="text-gray-400">Software Engineering</span>
						<span class="text-emerald-500 font-medium">Hot 🔥</span>
					</div>
					<div class="w-full bg-white/5 rounded-full h-1.5 overflow-hidden">
						<div class="bg-emerald-500 h-full w-[85%] rounded-full"></div>
					</div>
					<div class="flex items-center justify-between text-xs pt-2">
						<span class="text-gray-400">Average Salary (Senior)</span>
						<span class="text-white font-medium">$165k - $220k</span>
					</div>
				</div>
			</div>
		</div>
	</div>
</DashboardLayout>
