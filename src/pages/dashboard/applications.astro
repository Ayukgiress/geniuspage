---
import DashboardLayout from '../../layouts/DashboardLayout.astro';

const columns = [
	{ id: 'applied', name: 'Applied', count: 12, color: 'emerald' },
	{ id: 'interviewing', name: 'Interviewing', count: 5, color: 'blue' },
	{ id: 'offered', name: 'Offered', count: 2, color: 'purple' },
	{ id: 'closed', name: 'Closed', count: 23, color: 'gray' },
];

const jobs = [
	{ id: 1, company: 'Vercel', role: 'Senior Frontend Engineer', status: 'applied', logo: 'V', salary: '$180k - $220k' },
	{ id: 2, company: 'Stripe', role: 'Staff Product Designer', status: 'interviewing', logo: 'S', salary: '$210k - $250k' },
	{ id: 3, company: 'Linear', role: 'Core Systems Engineer', status: 'applied', logo: 'L', salary: '$190k - $230k' },
	{ id: 4, company: 'Airbnb', role: 'Full Stack Developer', status: 'offered', logo: 'A', salary: '$175k - $215k' },
	{ id: 5, company: 'Figma', role: 'Design Technologist', status: 'interviewing', logo: 'F', salary: '$185k - $225k' },
];
---

<DashboardLayout title="Applications | Genius">
	<div class="flex items-center justify-between mb-8">
		<div>
			<h1 class="text-3xl font-bold text-white mb-2">Job Applications</h1>
			<p class="text-gray-400">Track and manage your career opportunities.</p>
		</div>
		<button class="px-6 py-3 bg-emerald-500 text-black font-bold rounded-xl hover:bg-emerald-400 transition-all flex items-center gap-2">
			<svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
			Add New Job
		</button>
	</div>

	<!-- Kanban Board -->
	<div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6 h-full min-h-[600px]">
		{columns.map((column) => (
			<div class="flex flex-col gap-4">
				<div class="flex items-center justify-between px-2">
					<div class="flex items-center gap-2">
						<span class={`w-2 h-2 rounded-full ${
							column.color === 'emerald' ? 'bg-emerald-500' :
							column.color === 'blue' ? 'bg-blue-500' :
							column.color === 'purple' ? 'bg-purple-500' :
							'bg-gray-500'
						}`}></span>
						<h3 class="text-sm font-semibold text-white uppercase tracking-wider">{column.name}</h3>
					</div>
					<span class="text-xs font-medium text-gray-500 bg-white/5 px-2 py-0.5 rounded-full">{column.count}</span>
				</div>

				<div class="flex-1 bg-zinc-900/30 border border-white/5 rounded-2xl p-4 space-y-4 overflow-y-auto">
					{jobs.filter(job => job.status === column.id).map((job) => (
						<div class="bg-zinc-900/80 border border-white/10 rounded-xl p-4 hover:border-emerald-500/30 transition-all cursor-pointer group shadow-lg">
							<div class="flex items-start justify-between mb-4">
								<div class="w-10 h-10 bg-white/5 border border-white/10 rounded-lg flex items-center justify-center text-lg font-bold text-white group-hover:border-emerald-500/50 transition-colors">
									{job.logo}
								</div>
								<button class="text-gray-500 hover:text-white">
									<svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="1"/><circle cx="12" cy="5" r="1"/><circle cx="12" cy="19" r="1"/></svg>
								</button>
							</div>
							<h4 class="text-sm font-bold text-white mb-1">{job.role}</h4>
							<p class="text-xs text-gray-400 mb-4">{job.company}</p>
							
							<div class="flex items-center justify-between pt-4 border-t border-white/5 text-[10px]">
								<span class="text-gray-500">{job.salary}</span>
								<div class="flex -space-x-2">
									<div class="w-5 h-5 rounded-full bg-emerald-500/20 border border-black flex items-center justify-center text-[8px] text-emerald-500">AI</div>
									<div class="w-5 h-5 rounded-full bg-blue-500/20 border border-black flex items-center justify-center text-[8px] text-blue-500">HR</div>
								</div>
							</div>
						</div>
					))}
					
					{jobs.filter(job => job.status === column.id).length === 0 && (
						<div class="h-32 flex flex-col items-center justify-center border-2 border-dashed border-white/5 rounded-xl text-gray-600">
							<p class="text-[10px] uppercase font-bold tracking-widest">Drop here</p>
						</div>
					)}
				</div>
			</div>
		))}
	</div>
</DashboardLayout>
