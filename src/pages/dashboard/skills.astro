---
import DashboardLayout from '../../layouts/DashboardLayout.astro';

const topSkills = [
	{ name: 'React.js', proficiency: 95, match: 98, trend: 'stable' },
	{ name: 'TypeScript', proficiency: 88, match: 92, trend: 'up' },
	{ name: 'Node.js', proficiency: 82, match: 75, trend: 'up' },
	{ name: 'Next.js', proficiency: 90, match: 88, trend: 'stable' },
	{ name: 'Tailwind CSS', proficiency: 98, match: 95, trend: 'stable' },
];

const missingSkills = [
	{ name: 'GraphQL', gap: 65, demand: 'High', roles: ['Stripe', 'Meta'] },
	{ name: 'Docker', gap: 40, demand: 'Medium', roles: ['Vercel', 'Linear'] },
	{ name: 'PostgreSQL', gap: 30, demand: 'High', roles: ['Airbnb', 'Stripe'] },
];
---

<DashboardLayout title="Skills Analysis | Genius">
	<div class="mb-8">
		<h1 class="text-3xl font-bold text-white mb-2">Skill Gap Analysis</h1>
		<p class="text-gray-400">See how your profile matches up with market demands.</p>
	</div>

	<div class="grid grid-cols-1 lg:grid-cols-3 gap-8 mb-12">
		<!-- Main Skill Chart Area -->
		<div class="lg:col-span-2 space-y-8">
			<div class="bg-zinc-900/50 border border-white/5 rounded-3xl p-8">
				<div class="flex items-center justify-between mb-8">
					<h3 class="font-bold text-white text-lg">Top Skills Profile</h3>
					<div class="flex gap-4">
						<div class="flex items-center gap-2 text-xs">
							<span class="w-3 h-3 bg-emerald-500 rounded-full"></span>
							<span class="text-gray-400 font-medium">Proficiency</span>
						</div>
						<div class="flex items-center gap-2 text-xs">
							<span class="w-3 h-3 bg-emerald-500/30 rounded-full"></span>
							<span class="text-gray-400 font-medium">Market Match</span>
						</div>
					</div>
				</div>

				<div class="space-y-6">
					{topSkills.map((skill) => (
						<div class="group">
							<div class="flex items-center justify-between mb-2">
								<div class="flex items-center gap-2">
									<span class="text-sm font-semibold text-white group-hover:text-emerald-500 transition-colors">{skill.name}</span>
									{skill.trend === 'up' && (
										<svg xmlns="http://www.w3.org/2000/svg" class="w-3 h-3 text-emerald-500" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="23 6 13.5 15.5 8.5 10.5 1 18"/><polyline points="17 6 23 6 23 12"/></svg>
									)}
								</div>
								<div class="flex gap-4 text-[10px] font-bold uppercase tracking-wider">
									<span class="text-emerald-500">{skill.proficiency}%</span>
									<span class="text-gray-500">{skill.match}% Match</span>
								</div>
							</div>
							<div class="relative h-2 w-full bg-white/5 rounded-full overflow-hidden">
								<div class="absolute inset-0 bg-emerald-500/10 rounded-full" style={`width: ${skill.match}%`}></div>
								<div class="absolute inset-0 bg-emerald-500 rounded-full" style={`width: ${skill.proficiency}%`}></div>
							</div>
						</div>
					))}
				</div>
			</div>

			<div class="grid grid-cols-1 md:grid-cols-2 gap-6">
				<div class="bg-gradient-to-br from-blue-500/10 to-indigo-600/5 border border-blue-500/20 rounded-2xl p-6">
					<h4 class="text-blue-400 font-semibold mb-2">Learning Path</h4>
					<p class="text-white font-bold text-xl mb-1 tracking-tight">GraphQL Fundamentals</p>
					<p class="text-xs text-blue-500/80 mb-6">Master full-stack API design in 12 days.</p>
					<button class="w-full py-3 bg-blue-500 text-white font-bold rounded-xl hover:bg-blue-400 transition-all text-xs">Resume Course</button>
				</div>
				<div class="bg-gradient-to-br from-purple-500/10 to-fuchsia-600/5 border border-purple-500/20 rounded-2xl p-6">
					<h4 class="text-purple-400 font-semibold mb-2">Next Milestone</h4>
					<p class="text-white font-bold text-xl mb-1 tracking-tight">AWS Certified Developer</p>
					<p class="text-xs text-purple-500/80 mb-6">Boost your market match score by 15%.</p>
					<button class="w-full py-3 bg-purple-500 text-white font-bold rounded-xl hover:bg-purple-400 transition-all text-xs">Set Goal</button>
				</div>
			</div>
		</div>

		<!-- Skills to Acquire Sidebar -->
		<div class="space-y-8">
			<div class="bg-zinc-900/50 border border-white/5 rounded-3xl p-6">
				<h3 class="font-bold text-white mb-6">Top Missing Skills</h3>
				<div class="space-y-6">
					{missingSkills.map((skill) => (
						<div class="p-4 bg-white/5 border border-white/5 rounded-2xl hover:border-emerald-500/30 transition-colors">
							<div class="flex items-center justify-between mb-3">
								<span class="text-sm font-bold text-white">{skill.name}</span>
								<span class={`text-[10px] px-2 py-0.5 rounded-full font-bold uppercase tracking-wider ${
									skill.demand === 'High' ? 'bg-red-500/10 text-red-500' : 'bg-yellow-500/10 text-yellow-500'
								}`}>{skill.demand} Demand</span>
							</div>
							<div class="flex flex-wrap gap-2 mb-4">
								{skill.roles.map((role) => (
									<span class="text-[10px] text-gray-400 bg-white/5 px-2 py-0.5 rounded-md border border-white/5 font-medium">{role}</span>
								))}
							</div>
							<div class="flex items-center justify-between text-xs pt-3 border-t border-white/5">
								<span class="text-gray-500 font-medium">Gap Analysis</span>
								<span class="text-emerald-500 font-bold">-{skill.gap}%</span>
							</div>
						</div>
					))}
				</div>
			</div>

			<div class="bg-emerald-500 rounded-3xl p-6 shadow-xl shadow-emerald-500/10 relative overflow-hidden group">
				<div class="absolute top-0 right-0 p-4 opacity-10 group-hover:scale-110 transition-transform duration-500">
					<svg xmlns="http://www.w3.org/2000/svg" class="w-32 h-32 text-black" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 2v20M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"/></svg>
				</div>
				<h3 class="text-xl font-bold text-black mb-2 relative z-10">Salary Predictor</h3>
				<p class="text-black/70 text-sm mb-6 relative z-10 leading-relaxed font-medium">Add <b>GraphQL</b> and <b>Docker</b> to your profile to increase your expected salary by <b>$15,000/year</b>.</p>
				<button class="w-full py-3 bg-black text-white font-bold rounded-xl hover:bg-zinc-900 transition-all text-xs shadow-lg relative z-10">View Detailed Report</button>
			</div>
		</div>
	</div>
</DashboardLayout>
